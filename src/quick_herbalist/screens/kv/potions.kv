<PotionsScreen>:
    canvas.before:
        Color:
            rgb: 0, 0, 0
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: 12
        spacing: 6
        Label:
            id: title
            font_size: 32
            color: 1, 1, 1, 1
            size_hint_y: 0.1
        Label:
            id: message_lbl
            font_size: 18
            size_hint_y: 0.05
        BoxLayout:
            id: ingredient_strip
            orientation: 'horizontal'
            spacing: 6
            size_hint_x: 1
            size_hint_y: 0.19
            padding: 4
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 1
            spacing: 10
            FloatLayout:
                id: cauldron_zone
                size_hint_x: 0.45
                padding: 8
                Image:
                    id: cauldron_img
                    size: (250, 250)
                    size_hint: (None, None)
                    pos_hint: {'center': (0.5, 0.5)}
                GridLayout:
                    id: cauldron_grid
                    cols: 2
                    spacing: 4
                    size: (190, 190)
                    size_hint: (None, None)
                    pos_hint: {'center': (0.5, 0.5)}
                BoxLayout:
                    orientation: 'vertical'
                    size: (110, 120)
                    size_hint: (None, None)
                    pos_hint: {'x': 0, 'y': 0}
                    Draggable:
                        id: spoon
                        size_hint_y: 0.8
                        Image:
                            id: spoon_img
                            size: (70, 70)
                            size_hint: (None, None)
                            pos_hint: {'center': (0.5, 0.5)}
                    Label:
                        id: spoon_lbl
                        font_size: 12
                        halign: 'center'
                        color: 0.8, 0.8, 0.8, 1
            FloatLayout:
                id: book_page
                size_hint_x: 0.55
                Image:
                    id: book_img
                    allow_stretch: True
                    size_hint: (1, 1)
                    pos_hint: {'x': 0, 'y': 0}
                BoxLayout:
                    orientation: 'vertical'
                    size_hint: (1, 1)
                    pos_hint: {'x': 0, 'y': 0}
                    padding: 34, 10, 34, 10
                    spacing: 4
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.35
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Label:
                        id: recipe_name_lbl
                        font_size: 22
                        color: 1, 1, 1, 1
                        wrap: True
                        text_size: self.size
                        halign: 'center'
                        valign: 'middle'
                        size_hint_y: 0.22
                    Label:
                        id: recipe_desc_lbl
                        font_size: 14
                        color: 0.9, 0.9, 0.9, 1
                        wrap: True
                        text_size: self.size
                        halign: 'center'
                        valign: 'middle'
                        size_hint_y: 0.4
                    Label:
                        id: recipe_ingredients_lbl
                        font_size: 15
                        color: 0.6, 1, 0.6, 1
                        wrap: True
                        text_size: self.size
                        halign: 'center'
                        valign: 'middle'
                        size_hint_y: 0.23
                    Label:
                        id: recipe_duration_lbl
                        font_size: 13
                        color: 0.8, 0.8, 0.8, 1
                        wrap: True
                        text_size: self.size
                        halign: 'center'
                        valign: 'middle'
                        size_hint_y: 0.15
                Button:
                    id: prev_recipe_btn
                    size: (44, 44)
                    size_hint: (None, None)
                    pos_hint: {'x': 0, 'center_y': 0.5}
                    font_size: 16
                    text: '<<<'
                    on_release: root._flip_recipe(-1)
                Button:
                    id: next_recipe_btn
                    size: (44, 44)
                    size_hint: (None, None)
                    pos_hint: {'right': 1, 'center_y': 0.5}
                    font_size: 16
                    text: '>>>'
                    on_release: root._flip_recipe(1)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.2
            spacing: 8
            BoxLayout:
                id: run_slot_box
                orientation: 'horizontal'
                size_hint_x: 0.4
                spacing: 6
            ScrollView:
                do_scroll_x: True
                do_scroll_y: False
                size_hint_x: 0.6
                BoxLayout:
                    id: potion_strip
                    orientation: 'horizontal'
                    spacing: 6
                    size_hint_x: None
                    width: self.minimum_width
                    size_hint_y: 1
                    padding: 4
        Button:
            id: back_btn
            size_hint: (0.3, 0.08)
            pos_hint: {'center_x': 0.5}
            font_size: 16
            on_release: root.on_back()
