<GameMenuScreen>:
    canvas.before:
        Color:
            rgb: 0, 0, 0
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 15
        Label:
            id: title
            font_size: 40
            color: 1, 1, 1, 1
        BoxLayout:
            id: level_buttons
            orientation: 'vertical'
            spacing: 10
            size_hint_y: 0.5
        BoxLayout:
            orientation: 'horizontal'
            spacing: 10
            size_hint_y: 0.15
            Button:
                id: potions_btn
                font_size: 18
                on_release: root.manager.current = 'potions'
            Button:
                id: greenhouse_btn
                font_size: 18
                on_release: root.manager.current = 'greenhouse'
        Button:
            id: back_btn
            size_hint: (0.4, 0.15)
            pos_hint: {'center_x': 0.5}
            font_size: 18
            on_release: root.manager.current = 'menu'
