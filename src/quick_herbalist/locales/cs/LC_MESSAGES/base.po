#: game.py:16 game.py:207
msgid "Quick Herbalist"
msgstr "Rychlá bylinkářka"

#: game.py:211
msgid "Press 's' for start"
msgstr "Stiskni 's' pro začátek"

#: game.py:251 game.py:280
msgid "Collected: "
msgstr "Nasbíráno: "

#: game.py:252 game.py:281
msgid "Distance: "
msgstr "Vzdálenost: "

#: game.py:261
msgid "Do you want to quit?"
msgstr "Chceš skončit?"

#: game.py:265
msgid "Press 's' to continue"
msgstr "Stiskni 's' pro pokračování"

#: game.py:269
msgid "Press 'q' to quit"
msgstr "Stiskni 'q' pro ukončení"

#: game.py:279
msgid "GAME OVER!"
msgstr "KONEC HRY!"

#: screens.py
msgid "dandelion_sprite"
msgstr "Pampeliška"

#: screens.py
msgid "bluebell_sprite"
msgstr "Zvonkovka"

#: screens.py
msgid "Potion Crafting"
msgstr "Vytváření lektvarů"

#: screens.py
msgid "Back to Game Menu"
msgstr "Zpět do herního menu"

#: screens.py
msgid "Game Menu"
msgstr "Herní menu"

#: screens.py
msgid "Back to Main Menu"
msgstr "Zpět do hlavního menu"

#: screens.py
msgid "Drag onto cauldron to mix"
msgstr "Přetáhni do hrnce pro promíchání"

#: screens.py
msgid "Ingredients wasted"
msgstr "Suroviny prohozeny"

#: screens.py
msgid "Brewed: "
msgstr "Vymícháno: "

#: screens.py
msgid "Cauldron is empty"
msgstr "Hrnec je prázdný"

#: screens.py
msgid "Duration: "
msgstr "Trvání: "

#: potions.py
msgid "potion_magnetism_name"
msgstr "Magnetická píl"

#: potions.py
msgid "potion_magnetism_description"
msgstr "Automaticky táhne květy ve vzdálenosti do X pixelů směrem k tobě"

#: hints.py
msgid "Flower"
msgstr "Květiny"

#: hints.py
msgid "Flowers are collectible. Run through them to add them to your harvest."
msgstr "Květiny jsou sbíratelné. Projížděj přes ně a přidáš je do své sběre."

#: hints.py
msgid "Stone"
msgstr "Kámen"

#: hints.py
msgid "Stones are obstacles you need to avoid. If you run into them, your mission is over."
msgstr "Kameny jsou překážky, které musíš obejít. Pokud do kamene narazíš, tvá mise je skončena."

#: hints.py
msgid "Rock"
msgstr "Skála"

#: menu.py
msgid "Restart the game to apply language changes."
msgstr "Restartuj hru pro aplikování změny jazyka."

#: hints.py
msgid "Rocks are huge obstacles you cannot pass. If you run into them, your mission is over."
msgstr "Skály jsou obrovské překážky, kterými neprojdeš. Pokud do skály narazíš, tvá mise je skončena."

#: hints.py
msgid "Spider"
msgstr "Pavouk"

#: hints.py
msgid "Spiders crawl toward you and their sting ends the run. Keep your distance."
msgstr "Pavouci se plazí po zemi směrem k tobě a jejich štípnutí ukončí výpravu. Drž od nich odstoup."

#: hints.py
msgid "Hill"
msgstr "Kopeček"

#: hints.py
msgid "Hills are safe, but they slow you down while you run through them."
msgstr "Kopečky jsou bezpečné, ale zpomalí tě, zatím jimi projíždíš."

#: menu.py
msgid "Show in-game hints"
msgstr "Zobrazovat nápovědy ve hře"

#: menu.py
msgid "Tutorial popups shown the first time you encounter each game entity."
msgstr "Tutoriálová okna zobrazovaná při prvním setkání s každým prvkem hry."
